# Copia este fichero a local.properties (Android Studio añade sdk.dir automáticamente).
# local.properties NO se versiona.

sdk.dir=C:/Users/TU_USUARIO/AppData/Local/Android/Sdk

# Backend Laravel. Debug: el PC visto desde el emulador (php artisan serve --host=0.0.0.0).
# Con un móvil físico usa la IP del PC en la red local, o `adb reverse tcp:8000 tcp:8000`
# y http://127.0.0.1:8000/
API_BASE_URL_DEBUG=http://10.0.2.2:8000/
API_BASE_URL=https://radioescucha.es/

# Google Maps SDK for Android (consola de Google Cloud, restringida al paquete de la app).
MAPS_API_KEY=

# Tiempo real. Mismo valor que VITE_PUSHER_APP_KEY / PUSHER_APP_CLUSTER del .env de Laravel.
PUSHER_KEY=
PUSHER_CLUSTER=eu
# Solo si usas Laravel Reverb o un servidor Pusher propio:
# PUSHER_HOST=192.168.0.10
# PUSHER_PORT=8080
# PUSHER_TLS=false
